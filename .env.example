# ==============================================
# NPC FixIt Center — Root Environment Variables
# Copy this to .env and fill in your values
# ==============================================

# PostgreSQL
POSTGRES_USER=npc_user
POSTGRES_PASSWORD=npc_secret_2024
POSTGRES_DB=npc_fixitcenter

# Redis
REDIS_PASSWORD=redis_secret_2024

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM (must be exactly 32 hex chars = 16 bytes)
AES_KEY=0123456789abcdef0123456789abcdef

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
